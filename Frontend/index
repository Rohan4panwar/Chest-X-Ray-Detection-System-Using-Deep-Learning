<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>PneumoScan — AI Chest X-Ray Analysis</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  :root{
    --bg:#0a0d12;--surface:#111520;--surface2:#161c2d;--card:#1b2236;
    --border:#232c42;--border2:#2d3a58;
    --text:#e8ecf4;--muted:#8a95b0;--dim:#4a5470;
    --accent:#4f8ef7;--accent2:#3d7aed;--accent-glow:rgba(79,142,247,0.15);
    --red:#f05a5a;--red-bg:rgba(240,90,90,0.12);
    --green:#4fc97e;--green-bg:rgba(79,201,126,0.12);
    --amber:#f0a84a;--amber-bg:rgba(240,168,74,0.1);
    --r:12px;--r2:8px;
  }
  body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh;overflow-x:hidden}

  /* ── Layout ── */
  .app{display:grid;grid-template-columns:260px 1fr;min-height:100vh}
  .sidebar{background:var(--surface);border-right:1px solid var(--border);padding:0;display:flex;flex-direction:column}
  .main{padding:32px;overflow-y:auto}

  /* ── Sidebar ── */
  .logo{padding:28px 24px 20px;border-bottom:1px solid var(--border)}
  .logo h1{font-size:18px;font-weight:600;letter-spacing:-0.3px;color:var(--text)}
  .logo span{color:var(--accent)}
  .logo p{font-size:12px;color:var(--muted);margin-top:4px;font-family:'DM Mono',monospace}
  nav{padding:16px 12px;flex:1}
  .nav-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:var(--r2);cursor:pointer;color:var(--muted);font-size:14px;font-weight:400;transition:all .15s;margin-bottom:2px;border:none;background:none;width:100%;text-align:left}
  .nav-item:hover{background:var(--surface2);color:var(--text)}
  .nav-item.active{background:var(--accent-glow);color:var(--accent);font-weight:500}
  .nav-icon{width:18px;height:18px;flex-shrink:0}
  .sidebar-bottom{padding:16px;border-top:1px solid var(--border)}
  .status-pill{display:flex;align-items:center;gap:8px;padding:10px 12px;background:var(--surface2);border-radius:var(--r2);font-size:12px;color:var(--muted)}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green);flex-shrink:0}
  .dot.off{background:var(--red);box-shadow:0 0 6px var(--red)}

  /* ── Page header ── */
  .page-header{margin-bottom:28px}
  .page-header h2{font-size:22px;font-weight:600;letter-spacing:-0.4px}
  .page-header p{font-size:14px;color:var(--muted);margin-top:4px}

  /* ── Stats row ── */
  .stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:28px}
  .stat-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:16px 18px}
  .stat-card .label{font-size:12px;color:var(--muted);margin-bottom:8px;font-family:'DM Mono',monospace;text-transform:uppercase;letter-spacing:.5px}
  .stat-card .value{font-size:26px;font-weight:600;letter-spacing:-0.5px}
  .stat-card .sub{font-size:12px;color:var(--muted);margin-top:4px}

  /* ── Upload zone ── */
  .upload-area{background:var(--card);border:2px dashed var(--border2);border-radius:var(--r);padding:48px;text-align:center;cursor:pointer;transition:all .2s;position:relative}
  .upload-area:hover,.upload-area.drag{border-color:var(--accent);background:var(--surface2)}
  .upload-area input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
  .upload-icon{width:48px;height:48px;background:var(--accent-glow);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;border:1px solid rgba(79,142,247,.3)}
  .upload-icon svg{width:22px;height:22px;stroke:var(--accent);fill:none}
  .upload-area h3{font-size:16px;font-weight:500;margin-bottom:6px}
  .upload-area p{font-size:13px;color:var(--muted)}
  .upload-area .formats{font-family:'DM Mono',monospace;font-size:11px;color:var(--dim);margin-top:8px}

  /* ── Two-column layout ── */
  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px}

  /* ── Card ── */
  .card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:20px}
  .card-title{font-size:13px;font-weight:500;color:var(--muted);margin-bottom:16px;text-transform:uppercase;letter-spacing:.5px;font-family:'DM Mono',monospace}

  /* ── Result banner ── */
  .result-banner{border-radius:var(--r);padding:20px 24px;margin-bottom:20px;display:flex;align-items:center;gap:16px}
  .result-banner.normal{background:var(--green-bg);border:1px solid rgba(79,201,126,.3)}
  .result-banner.pneumonia{background:var(--red-bg);border:1px solid rgba(240,90,90,.3)}
  .result-banner.loading{background:var(--amber-bg);border:1px solid rgba(240,168,74,.3)}
  .result-icon{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .result-banner.normal .result-icon{background:rgba(79,201,126,.2)}
  .result-banner.pneumonia .result-icon{background:rgba(240,90,90,.2)}
  .result-banner .result-label{font-size:18px;font-weight:600}
  .result-banner.normal .result-label{color:var(--green)}
  .result-banner.pneumonia .result-label{color:var(--red)}
  .result-banner .result-conf{font-size:13px;color:var(--muted);margin-top:2px}

  /* ── Confidence bar ── */
  .conf-bar-wrap{margin-top:12px}
  .conf-bar-track{background:var(--surface2);border-radius:99px;height:6px;overflow:hidden;margin-top:6px}
  .conf-bar-fill{height:100%;border-radius:99px;transition:width .5s cubic-bezier(.4,0,.2,1)}
  .conf-bar-fill.normal{background:var(--green)}
  .conf-bar-fill.pneumonia{background:var(--red)}

  /* ── Image preview ── */
  .xray-preview{border-radius:var(--r2);overflow:hidden;background:#000;aspect-ratio:1;display:flex;align-items:center;justify-content:center}
  .xray-preview img{width:100%;height:100%;object-fit:contain}
  .xray-placeholder{color:var(--dim);font-size:13px;text-align:center;padding:40px}

  /* ── Patient form ── */
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
  .form-group{display:flex;flex-direction:column;gap:6px}
  .form-group label{font-size:12px;color:var(--muted);font-family:'DM Mono',monospace}
  .form-group input,.form-group select{background:var(--surface2);border:1px solid var(--border2);border-radius:var(--r2);padding:9px 12px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;outline:none;transition:border-color .15s}
  .form-group input:focus,.form-group select:focus{border-color:var(--accent)}
  .form-group select option{background:var(--surface)}

  /* ── Buttons ── */
  .btn{padding:10px 20px;border-radius:var(--r2);font-family:'DM Sans',sans-serif;font-size:14px;font-weight:500;cursor:pointer;border:none;transition:all .15s}
  .btn-primary{background:var(--accent);color:#fff}
  .btn-primary:hover{background:var(--accent2)}
  .btn-primary:disabled{opacity:.4;cursor:not-allowed}
  .btn-ghost{background:transparent;color:var(--muted);border:1px solid var(--border2)}
  .btn-ghost:hover{border-color:var(--border);color:var(--text)}
  .btn-danger{background:var(--red-bg);color:var(--red);border:1px solid rgba(240,90,90,.3)}

  /* ── History table ── */
  .history-table{width:100%;border-collapse:collapse}
  .history-table th{font-size:11px;color:var(--dim);text-align:left;padding:8px 12px;border-bottom:1px solid var(--border);font-family:'DM Mono',monospace;text-transform:uppercase;letter-spacing:.5px;font-weight:400}
  .history-table td{padding:10px 12px;font-size:13px;border-bottom:1px solid var(--border);vertical-align:middle}
  .history-table tr:last-child td{border-bottom:none}
  .badge{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:99px;font-size:11px;font-weight:500;font-family:'DM Mono',monospace}
  .badge.normal{background:var(--green-bg);color:var(--green)}
  .badge.pneumonia{background:var(--red-bg);color:var(--red)}

  /* ── Training panel ── */
  .train-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:20px}
  .metric-tile{background:var(--surface2);border:1px solid var(--border);border-radius:var(--r2);padding:14px 16px}
  .metric-tile .m-label{font-size:11px;color:var(--dim);font-family:'DM Mono',monospace;margin-bottom:6px}
  .metric-tile .m-val{font-size:20px;font-weight:600;color:var(--accent)}

  /* ── Chart ── */
  canvas{display:block;width:100%!important}

  /* ── Loader ── */
  .spinner{width:20px;height:20px;border:2px solid var(--border2);border-top-color:var(--accent);border-radius:50%;animation:spin .6s linear infinite;display:inline-block}
  @keyframes spin{to{transform:rotate(360deg)}}

  /* ── Toast ── */
  .toast-container{position:fixed;bottom:24px;right:24px;display:flex;flex-direction:column;gap:8px;z-index:999}
  .toast{background:var(--card);border:1px solid var(--border2);border-radius:var(--r2);padding:12px 16px;font-size:13px;min-width:200px;animation:slideup .2s ease;display:flex;align-items:center;gap:10px}
  @keyframes slideup{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

  .hidden{display:none!important}
  .mt{margin-top:16px}
  .flex-end{display:flex;justify-content:flex-end;gap:10px}
</style>
</head>
<body>

<div class="app">
  <!-- ── Sidebar ── -->
  <aside class="sidebar">
    <div class="logo">
      <h1>Pneumo<span>Scan</span></h1>
      <p>AI · Chest X-Ray Analysis</p>
    </div>
    <nav>
      <button class="nav-item active" onclick="showPage('scan')" id="nav-scan">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 12l2 2 4-4"/></svg>
        New Scan
      </button>
      <button class="nav-item" onclick="showPage('history')" id="nav-history">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="9"/></svg>
        Scan History
      </button>
      <button class="nav-item" onclick="showPage('training')" id="nav-training">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Model Training
      </button>
      <button class="nav-item" onclick="showPage('about')" id="nav-about">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        About
      </button>
    </nav>
    <div class="sidebar-bottom">
      <div class="status-pill">
        <span class="dot" id="api-dot"></span>
        <span id="api-status">Checking API...</span>
      </div>
    </div>
  </aside>

  <!-- ── Main ── -->
  <main class="main">

    <!-- ────── SCAN PAGE ────── -->
    <div id="page-scan">
      <div class="page-header">
        <h2>Chest X-Ray Analysis</h2>
        <p>Upload a chest X-ray image to detect signs of pneumonia using AI</p>
      </div>

      <!-- Stats -->
      <div class="stats-row" id="stats-row">
        <div class="stat-card"><div class="label">Total Scans</div><div class="value" id="s-total">—</div></div>
        <div class="stat-card"><div class="label">Pneumonia</div><div class="value" id="s-pneumonia" style="color:var(--red)">—</div></div>
        <div class="stat-card"><div class="label">Normal</div><div class="value" id="s-normal" style="color:var(--green)">—</div></div>
        <div class="stat-card"><div class="label">Avg Confidence</div><div class="value" id="s-conf" style="color:var(--accent)">—</div></div>
      </div>

      <!-- Upload -->
      <div class="two-col">
        <div>
          <div class="card" style="margin-bottom:16px">
            <div class="card-title">Patient Info (optional)</div>
            <div class="form-row">
              <div class="form-group"><label>Patient Name</label><input type="text" id="p-name" placeholder="Full name"/></div>
              <div class="form-group"><label>Age</label><input type="number" id="p-age" placeholder="e.g. 45" min="1" max="120"/></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Gender</label>
                <select id="p-gender"><option value="">Select...</option><option value="M">Male</option><option value="F">Female</option><option value="O">Other</option></select>
              </div>
              <div class="form-group"><label>Notes</label><input type="text" id="p-notes" placeholder="Clinical notes..."/></div>
            </div>
          </div>

          <div class="upload-area" id="upload-area" ondragover="onDrag(event)" ondragleave="onDragLeave(event)" ondrop="onDrop(event)">
            <input type="file" id="file-input" accept="image/*" onchange="onFileSelect(event)"/>
            <div class="upload-icon">
              <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </div>
            <h3>Drop X-Ray image here</h3>
            <p>or click to browse files</p>
            <div class="formats">JPEG · PNG · BMP · TIFF · WEBP</div>
          </div>

          <div class="flex-end mt">
            <button class="btn btn-ghost" onclick="clearAll()">Clear</button>
            <button class="btn btn-primary" id="analyze-btn" onclick="analyze()" disabled>
              <span id="analyze-label">Analyze</span>
              <span id="analyze-spinner" class="hidden" style="margin-left:8px"><span class="spinner" style="width:14px;height:14px;border-width:1.5px"></span></span>
            </button>
          </div>
        </div>

        <!-- Preview & Result -->
        <div>
          <div class="card" style="margin-bottom:16px">
            <div class="card-title">Image Preview</div>
            <div class="xray-preview" id="xray-preview">
              <div class="xray-placeholder">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin:0 auto 8px;display:block;opacity:.3"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                No image selected
              </div>
            </div>
          </div>

          <div id="result-area" class="hidden">
            <div id="result-banner" class="result-banner">
              <div class="result-icon" id="result-icon"></div>
              <div>
                <div class="result-label" id="result-label">—</div>
                <div class="result-conf" id="result-conf">—</div>
              </div>
            </div>
            <div class="card">
              <div class="card-title">Confidence Score</div>
              <div class="conf-bar-wrap">
                <div style="display:flex;justify-content:space-between;font-size:13px">
                  <span>Normal</span><span>Pneumonia</span>
                </div>
                <div class="conf-bar-track" style="margin-top:8px">
                  <div class="conf-bar-fill" id="conf-fill" style="width:0%"></div>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-top:6px">
                  <span id="conf-left">—</span><span id="conf-right">—</span>
                </div>
              </div>
              <div style="margin-top:16px;font-size:12px;color:var(--dim);line-height:1.6">
                ⚠️ This tool is for research purposes only. Always consult a qualified radiologist for clinical decisions.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ────── HISTORY PAGE ────── -->
    <div id="page-history" class="hidden">
      <div class="page-header">
        <h2>Scan History</h2>
        <p>Recent chest X-ray analyses</p>
      </div>
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
          <div class="card-title" style="margin:0">Recent Scans</div>
          <button class="btn btn-ghost" onclick="loadHistory()" style="font-size:12px;padding:6px 14px">Refresh</button>
        </div>
        <div id="history-loading" style="text-align:center;padding:32px;color:var(--dim)">Loading...</div>
        <table class="history-table hidden" id="history-table">
          <thead>
            <tr>
              <th>Date</th><th>Filename</th><th>Result</th><th>Confidence</th><th>Patient</th>
            </tr>
          </thead>
          <tbody id="history-body"></tbody>
        </table>
        <div id="history-empty" class="hidden" style="text-align:center;padding:48px;color:var(--dim)">
          No scans yet. Upload a chest X-ray to get started.
        </div>
      </div>
    </div>

    <!-- ────── TRAINING PAGE ────── -->
    <div id="page-training" class="hidden">
      <div class="page-header">
        <h2>Model Training</h2>
        <p>Train or retrain the pneumonia detection model</p>
      </div>

      <div class="two-col" style="margin-bottom:20px">
        <div class="card">
          <div class="card-title">Model Performance</div>
          <div class="train-grid" id="train-metrics">
            <div class="metric-tile"><div class="m-label">Accuracy</div><div class="m-val" id="m-acc">—</div></div>
            <div class="metric-tile"><div class="m-label">Val Accuracy</div><div class="m-val" id="m-vacc">—</div></div>
            <div class="metric-tile"><div class="m-label">AUC</div><div class="m-val" id="m-auc">—</div></div>
            <div class="metric-tile"><div class="m-label">F1 Score</div><div class="m-val" id="m-f1">—</div></div>
          </div>
          <button class="btn btn-primary" id="train-btn" onclick="triggerTraining()" style="width:100%">
            <span id="train-label">Start Training</span>
            <span id="train-spinner" class="hidden" style="margin-left:8px"><span class="spinner" style="width:14px;height:14px;border-width:1.5px"></span></span>
          </button>
          <p style="font-size:12px;color:var(--dim);margin-top:10px;line-height:1.5">
            Training uses MobileNetV2 with transfer learning on the chest X-ray dataset.
            This runs in the background and may take several minutes.
          </p>
        </div>

        <div class="card">
          <div class="card-title">Dataset Info</div>
          <div id="dataset-info" style="color:var(--muted);font-size:13px;line-height:1.8">
            <div>Training images: <span style="color:var(--text)" id="ds-train">—</span></div>
            <div>Validation images: <span style="color:var(--text)" id="ds-val">—</span></div>
            <div>Test images: <span style="color:var(--text)" id="ds-test">—</span></div>
            <div style="margin-top:12px">Architecture: <span style="color:var(--accent);font-family:'DM Mono',monospace">MobileNetV2</span></div>
            <div>Input size: <span style="color:var(--accent);font-family:'DM Mono',monospace">224×224</span></div>
            <div>Classes: <span style="color:var(--accent);font-family:'DM Mono',monospace">NORMAL · PNEUMONIA</span></div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Training History</div>
        <canvas id="train-chart" height="280"></canvas>
        <div id="chart-empty" style="text-align:center;padding:48px;color:var(--dim);font-size:13px">
          No training history yet. Train the model to see results.
        </div>
      </div>
    </div>

    <!-- ────── ABOUT PAGE ────── -->
    <div id="page-about" class="hidden">
      <div class="page-header">
        <h2>About PneumoScan</h2>
        <p>Technical details and architecture</p>
      </div>
      <div class="two-col">
        <div class="card">
          <div class="card-title">System Architecture</div>
          <div style="font-size:14px;line-height:1.9;color:var(--muted)">
            <p style="margin-bottom:12px;color:var(--text)">Full-stack AI pipeline for automated pneumonia detection from chest X-rays.</p>
            <div style="display:flex;flex-direction:column;gap:8px">
              <div style="background:var(--surface2);border-radius:var(--r2);padding:10px 14px;display:flex;gap:10px;align-items:center">
                <span style="font-family:'DM Mono',monospace;font-size:11px;color:var(--accent);min-width:80px">Frontend</span>
                <span style="font-size:13px">HTML · CSS · Vanilla JS</span>
              </div>
              <div style="background:var(--surface2);border-radius:var(--r2);padding:10px 14px;display:flex;gap:10px;align-items:center">
                <span style="font-family:'DM Mono',monospace;font-size:11px;color:var(--accent);min-width:80px">Backend</span>
                <span style="font-size:13px">Python · Flask · REST API</span>
              </div>
              <div style="background:var(--surface2);border-radius:var(--r2);padding:10px 14px;display:flex;gap:10px;align-items:center">
                <span style="font-family:'DM Mono',monospace;font-size:11px;color:var(--accent);min-width:80px">ML Model</span>
                <span style="font-size:13px">TensorFlow · MobileNetV2</span>
              </div>
              <div style="background:var(--surface2);border-radius:var(--r2);padding:10px 14px;display:flex;gap:10px;align-items:center">
                <span style="font-family:'DM Mono',monospace;font-size:11px;color:var(--accent);min-width:80px">Database</span>
                <span style="font-size:13px">SQLite · Custom ORM</span>
              </div>
              <div style="background:var(--surface2);border-radius:var(--r2);padding:10px 14px;display:flex;gap:10px;align-items:center">
                <span style="font-family:'DM Mono',monospace;font-size:11px;color:var(--accent);min-width:80px">Dataset</span>
                <span style="font-size:13px">Chest X-Ray (NIH/Kaggle) or synthetic</span>
              </div>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-title">API Endpoints</div>
          <div style="font-size:13px;font-family:'DM Mono',monospace;color:var(--muted);display:flex;flex-direction:column;gap:6px">
            <div><span style="color:var(--green)">POST</span> <span style="color:var(--text)">/api/predict</span></div>
            <div><span style="color:var(--accent)">GET</span>  <span style="color:var(--text)">/api/predictions</span></div>
            <div><span style="color:var(--green)">POST</span> <span style="color:var(--text)">/api/patients</span></div>
            <div><span style="color:var(--accent)">GET</span>  <span style="color:var(--text)">/api/patients</span></div>
            <div><span style="color:var(--accent)">GET</span>  <span style="color:var(--text)">/api/stats</span></div>
            <div><span style="color:var(--accent)">GET</span>  <span style="color:var(--text)">/api/model/history</span></div>
            <div><span style="color:var(--green)">POST</span> <span style="color:var(--text)">/api/model/train</span></div>
            <div><span style="color:var(--accent)">GET</span>  <span style="color:var(--text)">/api/health</span></div>
          </div>
          <div style="margin-top:20px;font-size:12px;color:var(--dim);line-height:1.6">
            Base URL: <code style="color:var(--accent)">http://localhost:5000</code><br/>
            Start the backend with: <code style="color:var(--accent)">./run.sh</code>
          </div>
        </div>
      </div>
    </div>

  </main>
</div>

<!-- Toasts -->
<div class="toast-container" id="toasts"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
const API = 'http://localhost:5000/api';
let selectedFile = null;
let trainChart = null;

// ── Navigation ────────────────────────────────────────────────────────────────
function showPage(p) {
  ['scan','history','training','about'].forEach(pg => {
    document.getElementById('page-'+pg).classList.toggle('hidden', pg !== p);
    document.getElementById('nav-'+pg).classList.toggle('active', pg === p);
  });
  if (p === 'history') loadHistory();
  if (p === 'training') loadTrainingData();
}

// ── API Health ─────────────────────────────────────────────────────────────────
async function checkHealth() {
  try {
    const r = await fetch(API+'/health', {signal: AbortSignal.timeout(3000)});
    const d = await r.json();
    document.getElementById('api-dot').className = 'dot';
    document.getElementById('api-status').textContent = d.model_loaded ? 'Model loaded' : 'API online (no model)';
    loadStats();
  } catch {
    document.getElementById('api-dot').className = 'dot off';
    document.getElementById('api-status').textContent = 'API offline';
  }
}

// ── Stats ─────────────────────────────────────────────────────────────────────
async function loadStats() {
  try {
    const r = await fetch(API+'/stats');
    const d = await r.json();
    document.getElementById('s-total').textContent = d.total ?? 0;
    document.getElementById('s-pneumonia').textContent = d.pneumonia ?? 0;
    document.getElementById('s-normal').textContent = d.normal ?? 0;
    document.getElementById('s-conf').textContent = d.avg_confidence ? (d.avg_confidence*100).toFixed(1)+'%' : '—';
  } catch {}
}

// ── File handling ─────────────────────────────────────────────────────────────
function onFileSelect(e) {
  const f = e.target.files[0];
  if (f) setFile(f);
}
function onDrag(e) { e.preventDefault(); document.getElementById('upload-area').classList.add('drag'); }
function onDragLeave() { document.getElementById('upload-area').classList.remove('drag'); }
function onDrop(e) {
  e.preventDefault();
  document.getElementById('upload-area').classList.remove('drag');
  const f = e.dataTransfer.files[0];
  if (f && f.type.startsWith('image/')) setFile(f);
}
function setFile(f) {
  selectedFile = f;
  const url = URL.createObjectURL(f);
  document.getElementById('xray-preview').innerHTML = `<img src="${url}" alt="X-Ray preview"/>`;
  document.getElementById('analyze-btn').disabled = false;
  document.getElementById('result-area').classList.add('hidden');
}
function clearAll() {
  selectedFile = null;
  document.getElementById('xray-preview').innerHTML = `<div class="xray-placeholder"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin:0 auto 8px;display:block;opacity:.3"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>No image selected</div>`;
  document.getElementById('analyze-btn').disabled = true;
  document.getElementById('result-area').classList.add('hidden');
  document.getElementById('file-input').value = '';
}

// ── Analyze ───────────────────────────────────────────────────────────────────
async function analyze() {
  if (!selectedFile) return;
  const btn   = document.getElementById('analyze-btn');
  const label = document.getElementById('analyze-label');
  const spin  = document.getElementById('analyze-spinner');
  btn.disabled = true; label.textContent = 'Analyzing...'; spin.classList.remove('hidden');

  try {
    // Optional: create patient first
    let patientId = null;
    const pName = document.getElementById('p-name').value.trim();
    if (pName) {
      try {
        const pr = await fetch(API+'/patients', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({
            name: pName,
            age:  parseInt(document.getElementById('p-age').value)||null,
            gender: document.getElementById('p-gender').value||null,
          })
        });
        if (pr.ok) { const pd = await pr.json(); patientId = pd.id; }
      } catch {}
    }

    const form = new FormData();
    form.append('file', selectedFile);
    if (patientId) form.append('patient_id', patientId);
    const notes = document.getElementById('p-notes').value;
    if (notes) form.append('notes', notes);

    const res = await fetch(API+'/predict', {method:'POST', body:form});
    if (!res.ok) throw new Error(await res.text());
    const d = await res.json();
    showResult(d);
    loadStats();
    toast('Analysis complete', d.label === 'PNEUMONIA' ? 'red' : 'green');
    if (d.demo_mode) toast('Running in demo mode (no trained model found)', 'amber');
  } catch (err) {
    toast('Error: '+(err.message||'API unreachable'), 'red');
    console.error(err);
  } finally {
    btn.disabled = false; label.textContent = 'Analyze'; spin.classList.add('hidden');
  }
}

function showResult(d) {
  const isPneu  = d.label === 'PNEUMONIA';
  const conf    = (d.confidence*100).toFixed(1);
  const banner  = document.getElementById('result-banner');
  const icon    = document.getElementById('result-icon');
  banner.className = 'result-banner ' + (isPneu ? 'pneumonia' : 'normal');
  icon.innerHTML   = isPneu
    ? `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`
    : `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>`;
  document.getElementById('result-label').textContent = isPneu ? 'Pneumonia Detected' : 'No Pneumonia Detected';
  document.getElementById('result-conf').textContent  = `Confidence: ${conf}%`;
  const pneuPct = (d.raw_score*100).toFixed(1);
  const normPct = (100-d.raw_score*100).toFixed(1);
  const fill    = document.getElementById('conf-fill');
  fill.style.width = pneuPct+'%';
  fill.className = 'conf-bar-fill '+(isPneu?'pneumonia':'normal');
  document.getElementById('conf-left').textContent  = normPct+'%';
  document.getElementById('conf-right').textContent = pneuPct+'%';
  document.getElementById('result-area').classList.remove('hidden');
}

// ── History ───────────────────────────────────────────────────────────────────
async function loadHistory() {
  const loading = document.getElementById('history-loading');
  const table   = document.getElementById('history-table');
  const empty   = document.getElementById('history-empty');
  loading.classList.remove('hidden'); table.classList.add('hidden'); empty.classList.add('hidden');
  try {
    const r = await fetch(API+'/predictions?limit=100');
    const data = await r.json();
    loading.classList.add('hidden');
    if (!data.length) { empty.classList.remove('hidden'); return; }
    const body = document.getElementById('history-body');
    body.innerHTML = data.map(p => {
      const isPneu = p.label === 'PNEUMONIA';
      const dt     = new Date(p.created_at).toLocaleString();
      const conf   = (p.confidence*100).toFixed(1)+'%';
      return `<tr>
        <td style="color:var(--muted)">${dt}</td>
        <td style="font-family:'DM Mono',monospace;font-size:12px">${p.image_filename||'—'}</td>
        <td><span class="badge ${isPneu?'pneumonia':'normal'}">${p.label}</span></td>
        <td style="font-family:'DM Mono',monospace">${conf}</td>
        <td style="color:var(--muted)">${p.patient_name||'—'}</td>
      </tr>`;
    }).join('');
    table.classList.remove('hidden');
  } catch {
    loading.textContent = 'Failed to load. Is the backend running?';
  }
}

// ── Training ──────────────────────────────────────────────────────────────────
async function loadTrainingData() {
  try {
    const r = await fetch(API+'/model/history');
    if (!r.ok) return;
    const d = await r.json();
    const hist = d.history || {};
    const test = d.test_metrics || {};

    // Metrics
    const lastAcc = hist.accuracy && hist.accuracy.length
      ? (hist.accuracy[hist.accuracy.length-1]*100).toFixed(1)+'%' : '—';
    const lastVacc = hist.val_accuracy && hist.val_accuracy.length
      ? (hist.val_accuracy[hist.val_accuracy.length-1]*100).toFixed(1)+'%' : '—';
    document.getElementById('m-acc').textContent  = lastAcc;
    document.getElementById('m-vacc').textContent = lastVacc;
    document.getElementById('m-auc').textContent  = test.auc ? test.auc.toFixed(3) : '—';
    document.getElementById('m-f1').textContent   = test.f1_score ? test.f1_score.toFixed(3) : '—';

    // Chart
    if (hist.accuracy && hist.accuracy.length) {
      document.getElementById('chart-empty').classList.add('hidden');
      renderTrainChart(hist);
    }
  } catch {}

  // Stats
  try {
    const r2 = await fetch(API+'/stats');
    const s  = await r2.json();
    if (s.last_train_accuracy) document.getElementById('m-acc').textContent = (s.last_train_accuracy*100).toFixed(1)+'%';
    if (s.last_val_accuracy)   document.getElementById('m-vacc').textContent = (s.last_val_accuracy*100).toFixed(1)+'%';
  } catch {}
}

function renderTrainChart(hist) {
  const ctx = document.getElementById('train-chart').getContext('2d');
  if (trainChart) trainChart.destroy();
  const labels = hist.accuracy.map((_,i) => 'Ep '+(i+1));
  trainChart = new Chart(ctx, {
    type: 'line',
    data: {
      labels,
      datasets: [
        { label:'Train Accuracy', data: hist.accuracy.map(v=>(v*100).toFixed(2)),
          borderColor:'#4f8ef7', backgroundColor:'rgba(79,142,247,.08)',
          tension:.4, fill:true, pointRadius:3 },
        { label:'Val Accuracy', data: (hist.val_accuracy||[]).map(v=>(v*100).toFixed(2)),
          borderColor:'#4fc97e', backgroundColor:'rgba(79,201,126,.05)',
          tension:.4, fill:false, borderDash:[5,3], pointRadius:3 },
        { label:'Train Loss', data: (hist.loss||[]).map(v=>v.toFixed(4)),
          borderColor:'#f05a5a', tension:.4, fill:false, yAxisID:'y1', pointRadius:3 },
      ]
    },
    options: {
      responsive:true, interaction:{mode:'index',intersect:false},
      plugins:{ legend:{labels:{color:'#8a95b0',font:{family:'DM Mono',size:11}}} },
      scales:{
        x:{ ticks:{color:'#4a5470',font:{family:'DM Mono',size:10}}, grid:{color:'#232c42'} },
        y:{ ticks:{color:'#4a5470',font:{family:'DM Mono',size:10}}, grid:{color:'#232c42'},
            title:{display:true,text:'Accuracy %',color:'#4a5470'} },
        y1:{ position:'right', ticks:{color:'#4a5470',font:{family:'DM Mono',size:10}},
             grid:{drawOnChartArea:false},
             title:{display:true,text:'Loss',color:'#4a5470'} },
      }
    }
  });
}

async function triggerTraining() {
  const btn   = document.getElementById('train-btn');
  const label = document.getElementById('train-label');
  const spin  = document.getElementById('train-spinner');
  btn.disabled = true; label.textContent = 'Training started...'; spin.classList.remove('hidden');
  try {
    const r = await fetch(API+'/model/train', {method:'POST'});
    if (r.ok) {
      toast('Training started in background. Check back in a few minutes.', 'amber');
    } else {
      toast('Failed to start training', 'red');
    }
  } catch {
    toast('API unreachable', 'red');
  }
  setTimeout(() => {
    btn.disabled = false; label.textContent = 'Start Training'; spin.classList.add('hidden');
  }, 3000);
}

// ── Toast ─────────────────────────────────────────────────────────────────────
function toast(msg, type='green') {
  const colors = {green:'var(--green)',red:'var(--red)',amber:'var(--amber)'};
  const el = document.createElement('div');
  el.className = 'toast';
  el.innerHTML = `<span style="width:7px;height:7px;border-radius:50%;background:${colors[type]||colors.green};flex-shrink:0;display:block"></span><span>${msg}</span>`;
  document.getElementById('toasts').prepend(el);
  setTimeout(() => el.remove(), 4500);
}

// ── Init ──────────────────────────────────────────────────────────────────────
checkHealth();
setInterval(checkHealth, 15000);
</script>
</body>
</html>
