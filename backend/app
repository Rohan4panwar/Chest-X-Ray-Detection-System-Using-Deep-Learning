@app.route("/api/stats", methods=["GET"])
def stats():
    s = get_stats()
    runs = list_model_runs()
    latest = runs[0] if runs else None
    s["model_trained"] = os.path.exists(MODEL_PATH)
    if latest and latest.get("history"):
        h = latest["history"].get("history", {})
        s["last_train_accuracy"] = h.get("accuracy", [None])[-1]
        s["last_val_accuracy"]   = h.get("val_accuracy", [None])[-1]
        s["last_f1"]             = latest["history"].get("test_metrics", {}).get("f1_score")
    return jsonify(s)


@app.route("/api/model/history", methods=["GET"])
def model_history():
    if os.path.exists(HIST_PATH):
        with open(HIST_PATH) as f:
            return jsonify(json.load(f))
    runs = list_model_runs()
    if runs:
        return jsonify(runs[0].get("history", {}))
    return jsonify({"error": "No training history found"}), 404


@app.route("/api/model/train", methods=["POST"])
def trigger_training():
    """Start training in a background thread."""
    import threading

    def _train():
        try:
            # Ensure dataset exists
            from dataset.create_dataset import (
                make_dirs, generate_synthetic_dataset,
                get_dataset_stats, save_stats, DATASET_DIR,
            )
            train_dir = os.path.join(DATASET_DIR, "train", "NORMAL")
            if not os.path.isdir(train_dir) or not os.listdir(train_dir):
                make_dirs()
                generate_synthetic_dataset()
                save_stats(get_dataset_stats())

            from models.train_model import train
            _, record = train()
            save_model_run(record)
            global _model
            _model = None  # force reload
            print("[✓] Training complete.")
        except Exception:
            traceback.print_exc()

    t = threading.Thread(target=_train, daemon=True)
    t.start()
    return jsonify({"message": "Training started in background"}), 202


