    return jsonify(list_predictions(limit))


@app.route("/api/predictions/<pred_id>", methods=["GET"])
def get_single_prediction(pred_id):
    pred = get_prediction(pred_id)
    if not pred:
        return jsonify({"error": "Not found"}), 404
    # Attach thumbnail if file exists
    if pred.get("image_path") and os.path.exists(pred["image_path"]):
        try:
            img   = Image.open(pred["image_path"])
            thumb = img.copy()
            thumb.thumbnail((256, 256))
            pred["thumbnail"] = f"data:image/jpeg;base64,{img_to_b64(thumb)}"
        except Exception:
            pass
    return jsonify(pred)


