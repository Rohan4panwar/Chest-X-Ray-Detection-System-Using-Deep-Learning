@app.route("/api/predict", methods=["POST"])
def predict():
    """Accept image (multipart or JSON base64), return prediction."""
    try:
        patient_id = request.form.get("patient_id") or \
                     (request.json or {}).get("patient_id")
        notes      = request.form.get("notes") or \
                     (request.json or {}).get("notes")

        # ── Get image and process it  ─────────────────────────────────────────────────────────
        if "file" in request.files:
            f = request.files["file"]
            if not allowed_file(f.filename):
                return jsonify({"error": "File type not allowed"}), 400
            filename = secure_filename(f.filename)
            save_path = os.path.join(UPLOAD_DIR, filename)
            f.save(save_path)
            img = Image.open(save_path)

        elif request.is_json and "image_base64" in request.json:
            b64 = request.json["image_base64"]
            if "," in b64:
                b64 = b64.split(",", 1)[1]
            img_bytes = base64.b64decode(b64)
            img       = Image.open(io.BytesIO(img_bytes))
            filename  = request.json.get("filename", "upload.jpg")
            save_path = os.path.join(UPLOAD_DIR, secure_filename(filename))
            img.save(save_path)
        else:
            return jsonify({"error": "No image provided"}), 400

        # ── Predict it demo imag prdiction  ───────────────────────────────────────────────────────────
        label, confidence, raw_score, demo_mode = predict_image(img)

        # ── Persist ───────────────────────────────────────────────────────────
        record = save_prediction(
            image_filename=filename,
            label=label,
            confidence=confidence,
            raw_score=raw_score,
            patient_id=patient_id,
            image_path=save_path,
            notes=notes,
        )

        # ── Thumbnail ─────────────────────────────────────────────────────────
        thumb = img.copy()
        thumb.thumbnail((256, 256))
        thumb_b64 = img_to_b64(thumb)

        return jsonify({
            "id":           record["id"],
            "label":        label,
            "confidence":   confidence,
            "raw_score":    raw_score,
            "is_pneumonia": label == "PNEUMONIA",
            "demo_mode":    demo_mode,
            "filename":     filename,
            "thumbnail":    f"data:image/jpeg;base64,{thumb_b64}",
            "created_at":   record["created_at"],
        })

    except Exception:
        traceback.print_exc()
        return jsonify({"error": "Internal server error"}), 500


@app.route("/api/predictions", methods=["GET"])
def get_predictions():
