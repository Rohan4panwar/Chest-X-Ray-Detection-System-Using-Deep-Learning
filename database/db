
import os, sqlite3, json, uuid
from datetime import datetime

# ─── Path ─────────────────────────────────────────────────────────────────────
ROOT    = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DB_PATH = os.path.join(ROOT, "database", "pneumonia.db")
os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)


# ─── Connection helper ────────────────────────────────────────────────────────

def get_conn():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


# ─── Schema ───────────────────────────────────────────────────────────────────

SCHEMA = """
CREATE TABLE IF NOT EXISTS patients (
    id          TEXT PRIMARY KEY,
    name        TEXT NOT NULL,
    age         INTEGER,
    gender      TEXT,
    created_at  TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS predictions (
    id              TEXT PRIMARY KEY,
    patient_id      TEXT REFERENCES patients(id),
    image_filename  TEXT NOT NULL,
    image_path      TEXT,
    label           TEXT NOT NULL,           -- 'NORMAL' or 'PNEUMONIA'
    confidence      REAL NOT NULL,           -- 0.0 – 1.0
    raw_score       REAL,                    -- sigmoid output
    model_version   TEXT,
    notes           TEXT,
    created_at      TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS model_runs (
    id              TEXT PRIMARY KEY,
    epochs_trained  INTEGER,
    accuracy        REAL,
    val_accuracy    REAL,
    auc             REAL,
    f1_score        REAL,
    training_time   REAL,
    history_json    TEXT,
    created_at      TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_pred_patient
    ON predictions(patient_id);
CREATE INDEX IF NOT EXISTS idx_pred_label
    ON predictions(label);
"""


def init_db():
    with get_conn() as conn:
        conn.executescript(SCHEMA)
    print(f"[✓] DB initialised at {DB_PATH}")


# ─── Patient CRUD ─────────────────────────────────────────────────────────────

def create_patient(name: str, age: int = None, gender: str = None) -> dict:
    row = {
        "id":         str(uuid.uuid4()),
        "name":       name,
        "age":        age,
        "gender":     gender,
        "created_at": datetime.utcnow().isoformat(),
    }
    with get_conn() as conn:
        conn.execute(
            "INSERT INTO patients VALUES (:id,:name,:age,:gender,:created_at)",
            row)
    return row


def get_patient(patient_id: str) -> dict | None:
    with get_conn() as conn:
        row = conn.execute("SELECT * FROM patients WHERE id=?",
                           (patient_id,)).fetchone()
    return dict(row) if row else None


def list_patients() -> list[dict]:
    with get_conn() as conn:
        rows = conn.execute(
            "SELECT * FROM patients ORDER BY created_at DESC").fetchall()
    return [dict(r) for r in rows]


# ─── Prediction dtail ──────────────────────────────────────────────────────────

def save_prediction(
    image_filename: str,
    label: str,
    confidence: float,
    raw_score: float,
    patient_id: str = None,
    image_path: str = None,
    model_version: str = "v1",
    notes: str = None,
) -> dict:
    row = {
        "id":             str(uuid.uuid4()),
        "patient_id":     patient_id,
        "image_filename": image_filename,
        "image_path":     image_path,
        "label":          label,
        "confidence":     round(confidence, 6),
        "raw_score":      round(raw_score, 6),
        "model_version":  model_version,
        "notes":          notes,
        "created_at":     datetime.utcnow().isoformat(),
    }
    with get_conn() as conn:
        conn.execute("""
            INSERT INTO predictions
            VALUES (:id,:patient_id,:image_filename,:image_path,
                    :label,:confidence,:raw_score,:model_version,
                    :notes,:created_at)""", row)
    return row


def get_prediction(pred_id: str) -> dict | None:
    with get_conn() as conn:
        row = conn.execute("SELECT * FROM predictions WHERE id=?",
                           (pred_id,)).fetchone()
    return dict(row) if row else None


def list_predictions(limit: int = 50) -> list[dict]:
    with get_conn() as conn:
        rows = conn.execute("""
            SELECT p.*, pt.name AS patient_name
            FROM predictions p
            LEFT JOIN patients pt ON p.patient_id = pt.id
            ORDER BY p.created_at DESC LIMIT ?""", (limit,)).fetchall()
    return [dict(r) for r in rows]


def get_stats() -> dict:
    with get_conn() as conn:
        total     = conn.execute("SELECT COUNT(*) FROM predictions").fetchone()[0]
        normal    = conn.execute(
            "SELECT COUNT(*) FROM predictions WHERE label='NORMAL'").fetchone()[0]
        pneumonia = conn.execute(
            "SELECT COUNT(*) FROM predictions WHERE label='PNEUMONIA'").fetchone()[0]
        avg_conf  = conn.execute(
            "SELECT AVG(confidence) FROM predictions").fetchone()[0] or 0.0
    return {
        "total":     total,
        "normal":    normal,
        "pneumonia": pneumonia,
        "avg_confidence": round(avg_conf, 4),
    }


# ─── Model run CRUD ───────────────────────────────────────────────────────────

def save_model_run(record: dict) -> dict:
    hist = record.get("history", {})
    test = record.get("test_metrics", {})
    row  = {
        "id":             str(uuid.uuid4()),
        "epochs_trained": record.get("epochs_trained"),
        "accuracy":       test.get("accuracy"),
        "val_accuracy":   hist.get("val_accuracy", [None])[-1],
        "auc":            test.get("auc"),
        "f1_score":       test.get("f1_score"),
        "training_time":  record.get("training_time_sec"),
        "history_json":   json.dumps(record),
        "created_at":     datetime.utcnow().isoformat(),
    }
    with get_conn() as conn:
        conn.execute("""
            INSERT INTO model_runs
            VALUES (:id,:epochs_trained,:accuracy,:val_accuracy,
                    :auc,:f1_score,:training_time,:history_json,:created_at)
        """, row)
    return row


def list_model_runs() -> list[dict]:
    with get_conn() as conn:
        rows = conn.execute(
            "SELECT * FROM model_runs ORDER BY created_at DESC").fetchall()
    results = []
    for r in rows:
        d = dict(r)
        if d.get("history_json"):
            d["history"] = json.loads(d.pop("history_json"))
        results.append(d)
    return results


# ─── Entry ────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    init_db()
    # Quick smoke-test
    p = create_patient("Test Patient", age=45, gender="M")
    print("Patient:", p)
    pred = save_prediction(
        image_filename="test.jpg",
        label="NORMAL",
        confidence=0.95,
        raw_score=0.05,
        patient_id=p["id"],
    )
    print("Prediction:", pred)
    print("Stats:", get_stats())
